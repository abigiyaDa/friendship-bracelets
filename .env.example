
SECRET_KEY=replace-with-your-local-secret
DEBUG=True

# Comma-separated lists. Defaults keep local dev working if unset.
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
CSRF_TRUSTED_ORIGINS=

DB_NAME=friendship_bracelets
DB_USER=your_mysql_user
DB_PASSWORD=your_mysql_password
DB_HOST=localhost
DB_PORT=3306
# Optional: path to a CA certificate for TLS connections to the MySQL server
# (e.g. Aiven's ca.pem). Relative paths are resolved from the project root.
# Leave empty for local development.
DB_SSL_CA=

# Media storage: local disk in dev; set USE_CLOUDINARY=True on the server for receipts
USE_CLOUDINARY=False
CLOUDINARY_URL=cloudinary://api_key:api_secret@your_cloud_name
